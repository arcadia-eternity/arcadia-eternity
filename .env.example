# 单进程服务；默认游客模式使用本机 SQLite 保存管理配置，无需外部数据库。
# 重启会丢弃活动房间/游戏会话，服务器身份、环境绑定和账号保留。
PORT=8102
HOST=0.0.0.0
NODE_ENV=development
# 未设置时首次启动生成并保存在 data-dir/identity.json；此目录需要持久保存。
# 已有服务器可显式指定同一个值，不能用改值的方式克隆账号空间。
# SERVER_ID=arcadia-local
ARCADIA_DATA_DIR=.arcadia-server
# 可选独立内容目录；默认 data-dir/workspace。
# ARCADIA_WORKSPACE_ROOT=/srv/arcadia/workspace
# SQLite 为默认。已有 DATABASE_URL 且未指定 STORAGE_DRIVER 时兼容选用 PostgreSQL。
# STORAGE_DRIVER=sqlite
# SQLITE_PATH=/srv/arcadia/server.sqlite
# PostgreSQL 模式同时配置以下两项，不要同时配置 SQLITE_PATH。
# STORAGE_DRIVER=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/arcadia
# 宿主登记的内容来源 JSON（包名 -> archive/directory/url/git 描述），不是远程任意路径入口。
# ARCADIA_CONTENT_SOURCES=/srv/arcadia/content-sources.json
# ARCADIA_NPM_REGISTRY=https://registry.npmjs.org/
# 私有 registry 的凭据只放受保护 npmrc 文件，不写入来源描述/环境包。
# ARCADIA_NPM_USERCONFIG=/run/secrets/arcadia-npmrc
# 离线准备只使用本机归档/目录与已有 npm 缓存；不能取得远程 Git/URL。
# ARCADIA_OFFLINE_CONTENT=1
# 只允许取得第三方内容，不授予服务器执行权限。
# ARCADIA_ALLOW_THIRD_PARTY_CONTENT=1
# 社区服明确允许其已批准内容的权威执行；官方维护服务保持关闭。
# 此开关同时允许取得内容；恢复/克隆时也据此允许静态编译作者 Effect。
# ARCADIA_ALLOW_THIRD_PARTY_EXECUTION=1
# 非回环管理请求要求 TLS。反向代理终止 TLS 时只信任明确 IP，不能填 CIDR/通配符。
# 同时将 PUBLIC_ORIGIN 设为 HTTPS，并由该代理提供 X-Forwarded-Proto: https。
# PUBLIC_ORIGIN=https://battle.example.com
# MANAGEMENT_TRUSTED_PROXY_IPS=10.0.0.5
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# 每局独占一个 Worker；空闲保留数量与同时对战上限分别控制。
ARCADIA_MAX_CONCURRENT_BATTLES=32
ARCADIA_MAX_IDLE_WORKERS=4
ARCADIA_MAX_QUEUED_BATTLES=64
# 默认客户端请求期限为 30 秒，初始化最多 20 秒；排队 5 秒留出准备余量。
# 增大此值时需同时考虑客户端请求期限。空闲保留与排队容量可设为 0。
ARCADIA_BATTLE_QUEUE_TIMEOUT_MS=5000

BATTLE_SERVER_URL=http://localhost:8102
VITE_WS_URL=http://localhost:8102
VITE_SOCKET_IO_PATH=/socket.io

# 可选 G3 本服账号；默认不设置 ACCOUNT_MODE，保持纯游客模式。
# SQLite 与 PostgreSQL 使用相同账号合同；数据库种类不决定是否能启用 G3。
# 启用前还需配置可发送邮件的 SMTP，以及支持用户授权的 GitHub App。
# G3 启用时将上方 CORS_ORIGIN 改成自己的网页域名，例如 https://battle.example.com；
# 该 origin 必须与 GitHub App 回调地址一致。
# ACCOUNT_MODE=g3
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=Arcadia <no-reply@example.com>
# SMTP_USER=
# SMTP_PASSWORD=
# GITHUB_APP_CLIENT_ID=your-github-app-client-id
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_REDIRECT_URIS=https://battle.example.com/account
# 回调地址须在 GitHub App 中逐条登记；官方服只登记 https://battle.yuuinih.com/account。
