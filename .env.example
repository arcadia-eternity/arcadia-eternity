# 单进程服务；默认游客模式无需 Redis 或数据库。重启会丢弃全部房间和会话。
PORT=8102
HOST=0.0.0.0
NODE_ENV=development
# 同一个服务重启/升级时保持不变；不同服务使用不同值。
SERVER_ID=arcadia-local
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

BATTLE_SERVER_URL=http://localhost:8102
VITE_WS_URL=http://localhost:8102
VITE_SOCKET_IO_PATH=/socket.io

# 可选 G3 本服账号；默认不设置 ACCOUNT_MODE，保持纯游客模式。
# 官方服复用现有 Supabase PostgreSQL；社区服可使用自己的 PostgreSQL。
# 启用前还需配置可发送邮件的 SMTP，以及支持用户授权的 GitHub App。
# G3 启用时将上方 CORS_ORIGIN 改成自己的网页域名，例如 https://battle.example.com；
# 该 origin 必须与 GitHub App 回调地址一致。
# ACCOUNT_MODE=g3
# DATABASE_URL=postgres://user:password@localhost:5432/arcadia
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=Arcadia <no-reply@example.com>
# SMTP_USER=
# SMTP_PASSWORD=
# GITHUB_APP_CLIENT_ID=your-github-app-client-id
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_REDIRECT_URIS=https://battle.example.com/account
# 回调地址须在 GitHub App 中逐条登记；官方服只登记 https://battle.yuuinih.com/account。
