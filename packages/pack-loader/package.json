{
  "name": "@arcadia-eternity/pack-loader",
  "version": "4.4.1",
  "description": "",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcadia-eternity/arcadia-eternity.git",
    "directory": "packages/pack-loader"
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./package.json": "./package.json",
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./effect-build": {
      "types": "./dist/effect-build.d.ts",
      "import": "./dist/effect-build.js"
    }
  },
  "scripts": {
    "build": "run-s clear build:code build:types",
    "clear": "rm -rf dist",
    "build:code": "rolldown -c",
    "watch:code": "rolldown -c --watch",
    "watch:types": "pnpm exec tsgo --emitDeclarationOnly --watch --preserveWatchOutput",
    "watch": "run-p watch:code watch:types",
    "build:types": "pnpm exec tsgo --emitDeclarationOnly",
    "test:run": "vitest run --maxWorkers=1",
    "generate:lockfile": "pnpm run build && node dist/generate-pack-lockfile.js",
    "typecheck": "pnpm exec tsgo --noEmit"
  },
  "keywords": [],
  "author": "yuuinih",
  "license": "MIT",
  "dependencies": {
    "@arcadia-eternity/battle": "workspace:*",
    "@arcadia-eternity/schema": "workspace:*",
    "es-module-lexer": "3.0.4",
    "rolldown": "1.3.1",
    "semver": "7.8.6",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/semver": "7.8.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE"
  ]
}
