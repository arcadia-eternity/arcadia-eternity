{
  "name": "@arcadia-eternity/pack-loader",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcadia-eternity/arcadia-eternity.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/src/native-loader.d.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "run-s clear build:code build:types",
    "clear": "rm -rf dist",
    "build:code": "rolldown -c",
    "watch:code": "rolldown -c --watch",
    "watch:types": "pnpm exec tsgo --emitDeclarationOnly --watch --preserveWatchOutput",
    "watch": "run-p watch:code watch:types",
    "build:types": "pnpm exec tsgo --emitDeclarationOnly",
    "test:run": "vitest run --maxWorkers=1",
    "generate:lockfile": "pnpm run build && node dist/generate-pack-lockfile.js"
  },
  "keywords": [],
  "author": "yuuinih",
  "license": "MIT",
  "dependencies": {
    "@arcadia-eternity/battle": "workspace:^",
    "@arcadia-eternity/schema": "workspace:^",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
