# One deployment-owned backend for auth, HTTP and Socket.IO.
# Use / for same-origin; split hosting uses an exact HTTP(S) origin.
VITE_BACKEND_ORIGIN=/

# Local and P2P-host battles use one Worker per active battle.
# Vite reads these at build time; rebuild the browser app after changing them.
# Excess launches wait in a bounded queue; healthy idle Workers retain loaded effects.
VITE_MAX_CONCURRENT_BATTLES=4
VITE_MAX_IDLE_WORKERS=1
VITE_MAX_QUEUED_BATTLES=4
VITE_BATTLE_QUEUE_TIMEOUT_MS=30000
