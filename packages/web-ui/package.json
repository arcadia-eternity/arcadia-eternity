{
  "name": "@arcadia-eternity/web-ui",
  "license": "MIT",
  "version": "4.2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcadia-eternity/arcadia-eternity.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s build:deps \"build-only {@}\" --",
    "build:deps": "pnpm --filter '@arcadia-eternity/web-ui^...' run build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:online": "pnpm run test:e2e:online:relay",
    "test:e2e:online:relay": "cross-env PLAYWRIGHT_ONLINE=1 PLAYWRIGHT_P2P_TRANSPORT=relay playwright test e2e/private-room-online.spec.ts",
    "test:e2e:online:webrtc": "cross-env PLAYWRIGHT_ONLINE=1 PLAYWRIGHT_P2P_TRANSPORT=webrtc playwright test e2e/private-room-online.spec.ts",
    "test:e2e:online:server": "cross-env PLAYWRIGHT_ONLINE=1 playwright test e2e/server-room-online.spec.ts",
    "test:e2e:online:matchmaking": "cross-env PLAYWRIGHT_ONLINE=1 playwright test e2e/matchmaking-online.spec.ts",
    "test:e2e:online:relay:external": "cross-env PLAYWRIGHT_ONLINE=1 PLAYWRIGHT_BASE_URL=http://127.0.0.1:4176 PLAYWRIGHT_P2P_TRANSPORT=relay playwright test e2e/private-room-online.spec.ts --config playwright.external.config.ts",
    "test:e2e:online:webrtc:external": "cross-env PLAYWRIGHT_ONLINE=1 PLAYWRIGHT_BASE_URL=http://127.0.0.1:4176 PLAYWRIGHT_P2P_TRANSPORT=webrtc playwright test e2e/private-room-online.spec.ts --config playwright.external.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:run": "vitest run",
    "test:desktop-local-content": "vitest run --config electron/test/local-content.vitest.config.mjs",
    "test:content-locales": "vitest run src/i18n/__tests__/contentLocales.test.ts src/i18n/__tests__/richDescription.test.ts src/components/__tests__/ContentDescription.test.ts src/features/authoring/__tests__/AuthorDescription.test.ts --maxWorkers=1",
    "build-only": "vite build",
    "type-check": "vue-tsc --build && vue-tsc --noEmit -p tsconfig.test.json",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint": "run-s lint:eslint",
    "format": "prettier --write src/",
    "dev:desktop": "run-p dev:desktop:web electron:dev",
    "dev:desktop:web": "vite --host localhost --port 5173 --strictPort",
    "electron:dev": "wait-on http://localhost:5173 && cross-env ARCADIA_ELECTRON_DEV_SERVER_URL=http://localhost:5173 electron ./electron/main.mjs --remote-debugging-port=9222",
    "build:desktop": "run-s build build:desktop:runtime:deps stage:desktop-runtime electron:pack",
    "build:desktop:preview": "run-s build build:desktop:runtime:deps stage:desktop-runtime:preview electron:pack:preview",
    "electron:pack": "electron-builder --publish never",
    "electron:pack:preview": "node ../../scripts/verify-desktop-pack.mjs --preview",
    "electron:pack:publish": "node ../../scripts/verify-desktop-pack.mjs && electron-builder --publish always",
    "build:static": "run-s build:deps build:static-only",
    "build:static-only": "cross-env VITE_STATIC_MODE=1 vite build && node ../../scripts/prepare-static-assets.mjs && node scripts/build-offline.mjs",
    "test:e2e:static": "playwright test --config playwright.static.config.ts",
    "stage:desktop-runtime": "node ../../scripts/stage-desktop-runtime.mjs --output dist/arcadia-server",
    "stage:desktop-runtime:preview": "node ../../scripts/stage-desktop-runtime.mjs --output dist/arcadia-server",
    "build:desktop:runtime:deps": "pnpm --filter @arcadia-eternity/server... run build",
    "typecheck": "pnpm run type-check",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@arcadia-eternity/battle": "workspace:^",
    "@arcadia-eternity/client": "workspace:^",
    "@arcadia-eternity/const": "workspace:^",
    "@arcadia-eternity/content-sdk": "workspace:^",
    "@arcadia-eternity/data-pack-base": "workspace:^",
    "@arcadia-eternity/interface": "workspace:^",
    "@arcadia-eternity/p2p-transport": "workspace:^",
    "@arcadia-eternity/pack-loader": "workspace:^",
    "@arcadia-eternity/protocol": "workspace:^",
    "@arcadia-eternity/schema": "workspace:^",
    "@element-plus/icons-vue": "^2.3.2",
    "@heroicons/vue": "^2.2.0",
    "@ruffle-rs/ruffle": "0.2.0-nightly.2026.3.15",
    "@simplewebauthn/browser": "13.2.2",
    "@sinclair/typebox": "catalog:",
    "@tailwindcss/vite": "^4.2.1",
    "@tsparticles/vue3": "^3.0.1",
    "@vueuse/core": "^14.2.1",
    "electron-updater": "^6.8.3",
    "element-plus": "^2.13.5",
    "gsap": "^3.14.2",
    "howler": "^2.2.4",
    "i18next": "catalog:",
    "i18next-chained-backend": "^5.0.2",
    "i18next-http-backend": "^4.0.2",
    "i18next-vue": "^5.4.0",
    "intl-messageformat": "^12.1.4",
    "jsondiffpatch": "catalog:",
    "mitt": "^3.0.1",
    "nanoid": "catalog:",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "rxjs": "catalog:",
    "seer2-pet-animator": "^0.0.37",
    "sortablejs": "^1.15.7",
    "sortablejs-vue3": "^1.3.0",
    "tailwindcss": "^4.2.1",
    "tsparticles": "^3.9.1",
    "ua-parser-js": "^2.0.10",
    "vue": "^3.5.42",
    "vue-router": "^5.0.3",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/howler": "^2.2.12",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/browser": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.0",
    "cross-env": "^10.1.0",
    "electron": "^41.10.6",
    "electron-builder": "^26.15.0",
    "eslint": "^10.0.3",
    "eslint-plugin-vue": "^10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.1",
    "npm": "11.17.0",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "tailwind-scrollbar": "^4.0.2",
    "typescript": "catalog:",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^3.3.0",
    "vite-plugin-vue-devtools": "^8.1.0",
    "vitest": "catalog:",
    "vue-tsc": "^3.2.5",
    "wait-on": "^9.0.4"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.arcadia.eternity",
    "productName": "Arcadia Eternity",
    "npmRebuild": false,
    "asar": true,
    "files": [
      "dist/**/*",
      "!dist/arcadia-server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "arcadia-eternity",
        "repo": "arcadia-eternity"
      }
    ],
    "mac": {
      "identity": null,
      "target": [
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "executableName": "arcadia-eternity",
      "category": "Game"
    },
    "extraResources": [
      {
        "from": "dist/arcadia-server",
        "to": "arcadia-server",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      },
      {
        "from": "dist/arcadia-server/node_modules",
        "to": "arcadia-server/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "beforePack": "../../scripts/verify-desktop-pack.mjs",
    "afterPack": "../../scripts/verify-desktop-pack.mjs"
  }
}
