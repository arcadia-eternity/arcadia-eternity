{
  "name": "@arcadia-eternity/content-sdk",
  "version": "4.4.2",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "arcadia-content": "./bin/arcadia-content.mjs",
    "arcadia-content-mcp": "./bin/arcadia-content-mcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": "./dist/testing.js",
    "./workspace": "./dist/author-api.js",
    "./management-workspace": {
      "types": "./dist/content-workspace.d.ts",
      "import": "./dist/content-workspace.js",
      "default": "./dist/content-workspace.js"
    },
    "./managed-projects": {
      "types": "./dist/managed-projects.d.ts",
      "import": "./dist/managed-projects.js",
      "default": "./dist/managed-projects.js"
    },
    "./environment-rules": {
      "types": "./dist/environment-rules.d.ts",
      "import": "./dist/environment-rules.js",
      "default": "./dist/environment-rules.js"
    },
    "./build": {
      "types": "./dist/effect-build.d.ts",
      "import": "./dist/effect-build.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test:run": "node --test --test-concurrency=1 test/*.test.mjs",
    "typecheck": "pnpm exec tsgo --noEmit",
    "watch": "node watch.mjs",
    "clear": "rm -rf dist"
  },
  "dependencies": {
    "@arcadia-eternity/battle": "workspace:*",
    "@arcadia-eternity/pack-loader": "workspace:*",
    "@arcadia-eternity/schema": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^6.0.0",
    "mime-types": "^3.0.2",
    "semver": "7.8.6",
    "tar": "^7.5.22",
    "typescript": "catalog:",
    "write-file-atomic": "^8.0.0",
    "yaml": "catalog:",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arcadia-eternity/arcadia-eternity.git",
    "directory": "packages/content-dev"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/semver": "7.8.0",
    "@types/write-file-atomic": "^4.0.3",
    "@types/yauzl": "^3.4.0"
  }
}
