{
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "outDir": "./dist/types/",
    "declaration": true,
    "declarationMap": true,
    "types": [
      "node"
    ],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "./index.ts",
    "./node.ts",
    "./src/index.ts",
    "./src/logger.ts",
    "./src/v2/**/*",
    "./v4.ts",
    "./src/v4/**/*.ts",
    "./v4-legacy.ts",
    "./src/v4/legacy/**/*.json",
    "./src/v4/legacy/**/*.json"
  ],
  "exclude": [
    "./node_modules",
    "./dist",
    "./src/**/__tests__"
  ]
}
