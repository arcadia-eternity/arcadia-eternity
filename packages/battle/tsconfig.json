{
  "compilerOptions": {
    "composite": true,
    "lib": ["ESNext"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "outDir": "./dist/types/",
    "declaration": true,
    "declarationMap": true,
    "types": ["node"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "./index.ts",
    "./pack.ts",
    "./v4-host.ts",
    "./src/v4-host/**/*.ts",
    "./src/pack/**/*.ts",
    "./src/index.ts",
    "./src/logger.ts",
    "./v4.ts",
    "./src/v4/**/*.ts",
    "./v4-legacy.ts",
    "./src/v4/legacy/**/*.json",
    "./src/v4/legacy/**/*.json",
    "./v4-authoring.ts"
  ],
  "exclude": ["./node_modules", "./dist", "./src/**/__tests__"]
}
