{
  "extends": "./tsconfig.v4.json",
  "compilerOptions": {
    "paths": {
      "@arcadia-eternity/battle/v4": ["./v4.ts"],
      "@arcadia-eternity/battle/v4/authoring": ["./v4-authoring.ts"],
      "@arcadia-eternity/data-pack-base/native": ["../../packs/base/native.ts"]
    }
  },
  "include": [
    "v4.ts",
    "v4-authoring.ts",
    "v4-host.ts",
    "v4-legacy.ts",
    "src/v4/**/*.ts",
    "src/v4-host/**/*.ts",
    "src/v4/**/*.json",
    "test/v4/**/*.ts",
    "test/v4/**/*.json"
  ],
  "exclude": ["node_modules", "dist"]
}
