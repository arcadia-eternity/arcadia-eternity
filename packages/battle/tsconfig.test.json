{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": "../..",
    "skipLibCheck": true,
    "paths": {
      "@arcadia-eternity/battle/engine": ["./engine.ts"],
      "@arcadia-eternity/battle/authoring": ["./authoring.ts"],
      "@arcadia-eternity/battle/host": ["./host.ts"],
      "@arcadia-eternity/data-pack-base/effects": ["../../packs/base/effects.ts"]
    }
  },
  "include": [
    "../../types/effect-module.d.ts",
    "*.ts",
    "src/**/*.ts",
    "src/**/*.json",
    "test/**/*.ts",
    "test/**/*.json"
  ],
  "exclude": ["node_modules", "dist"]
}
