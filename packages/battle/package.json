{
  "name": "@arcadia-eternity/battle",
  "version": "1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcadia-eternity/arcadia-eternity.git"
  },
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/types/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./pack": {
      "types": "./dist/types/pack.d.ts",
      "import": "./dist/pack.js",
      "default": "./dist/pack.js"
    },
    "./v4": {
      "types": "./dist/types/v4.d.ts",
      "import": "./dist/v4.js",
      "default": "./dist/v4.js"
    },
    "./v4/legacy": {
      "types": "./dist/types/v4-legacy.d.ts",
      "import": "./dist/v4-legacy.js",
      "default": "./dist/v4-legacy.js"
    },
    "./v4/host": {
      "types": "./dist/types/v4-host.d.ts",
      "import": "./dist/v4-host.js",
      "default": "./dist/v4-host.js"
    },
    "./v4/build": {
      "types": "./dist/native-build.d.ts",
      "import": "./dist/native-build.mjs",
      "default": "./dist/native-build.mjs"
    }
  },
  "scripts": {
    "build": "run-s clear build:code build:types",
    "clear": "rm -rf dist",
    "build:code": "rolldown -c && node ../../scripts/build-battle-environment.mjs",
    "watch:code": "rolldown -c --watch",
    "watch:types": "pnpm exec tsgo --emitDeclarationOnly --watch --preserveWatchOutput",
    "watch": "run-p watch:code watch:types",
    "build:types": "pnpm exec tsgo --emitDeclarationOnly",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [],
  "author": "yuuinih",
  "license": "MIT",
  "dependencies": {
    "@arcadia-eternity/const": "workspace:*",
    "@arcadia-eternity/engine": "workspace:*",
    "@arcadia-eternity/interface": "workspace:^",
    "@arcadia-eternity/plugin-damage": "workspace:*",
    "@arcadia-eternity/plugin-element": "workspace:*",
    "@arcadia-eternity/plugin-transformation": "workspace:*",
    "@sinclair/typebox": "catalog:",
    "jsondiffpatch": "catalog:",
    "mitt": "^3.0.1",
    "nanoid": "catalog:",
    "zod": "3.25.76",
    "zod-validation-error": "3.5.4"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
