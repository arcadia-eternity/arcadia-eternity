{
  "name": "@arcadia-eternity/battle",
  "version": "4.3.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcadia-eternity/arcadia-eternity.git",
    "directory": "packages/battle"
  },
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pack": {
      "types": "./dist/types/pack.d.ts",
      "import": "./dist/pack.js",
      "default": "./dist/pack.js"
    },
    "./engine": {
      "types": "./dist/types/engine.d.ts",
      "import": "./dist/engine.js",
      "default": "./dist/engine.js"
    },
    "./host": {
      "types": "./dist/types/host.d.ts",
      "import": "./dist/host.js",
      "default": "./dist/host.js"
    },
    "./build": {
      "types": "./dist/native-build.d.ts",
      "import": "./dist/native-build.mjs",
      "default": "./dist/native-build.mjs"
    },
    "./sandbox": {
      "types": "./dist/types/sandbox.d.ts",
      "import": "./dist/sandbox.js"
    },
    "./sandbox/effects": {
      "types": "./dist/types/sandbox-effects.d.ts",
      "import": "./dist/sandbox-effects.js"
    },
    "./sandbox/node": {
      "types": "./dist/types/sandbox-node.d.ts",
      "import": "./dist/sandbox-node.js"
    },
    "./sandbox/worker": "./dist/sandbox-worker.js",
    "./sandbox/node-worker": "./dist/sandbox-node-worker.js",
    "./authoring": {
      "types": "./dist/types/authoring.d.ts",
      "import": "./dist/authoring.js",
      "default": "./dist/authoring.js"
    }
  },
  "scripts": {
    "build": "run-s clear build:code build:types",
    "clear": "rm -rf dist",
    "build:code": "rolldown -c && node ../../scripts/build-battle-environment.mjs",
    "watch:code": "rolldown -c --watch",
    "watch:types": "pnpm exec tsgo --emitDeclarationOnly --watch --preserveWatchOutput",
    "watch": "run-p watch:code watch:types",
    "build:types": "pnpm exec tsgo --emitDeclarationOnly",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "pnpm exec tsgo --noEmit -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "yuuinih",
  "license": "MIT",
  "dependencies": {
    "@arcadia-eternity/const": "workspace:*",
    "@arcadia-eternity/interface": "workspace:*",
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "@sinclair/typebox": "catalog:",
    "comlink": "4.4.2",
    "jsondiffpatch": "catalog:",
    "mitt": "^3.0.1",
    "nanoid": "catalog:",
    "quickjs-emscripten": "0.32.0",
    "quickjs-emscripten-sync": "1.11.0",
    "zod": "3.25.76",
    "zod-validation-error": "3.5.4"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE"
  ]
}
