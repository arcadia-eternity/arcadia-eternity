{
  "compilerOptions": {
    "paths": {
      "*": ["./*"]
    },
    "composite": true,
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist/",
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./src/**/*"],
  "exclude": ["./node_modules", "./dist"]
}
