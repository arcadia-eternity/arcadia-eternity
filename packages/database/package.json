{
  "name": "@arcadia-eternity/database",
  "version": "1.0.0",
  "description": "Server-owned SQLite and PostgreSQL persistence",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcadia-eternity/arcadia-eternity.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "run-p build:code build:types",
    "clear": "rm -rf dist",
    "build:code": "rolldown -c",
    "watch:code": "rolldown -c --watch",
    "watch:types": "pnpm exec tsgo --emitDeclarationOnly --watch --preserveWatchOutput",
    "watch": "run-p watch:code watch:types",
    "build:types": "pnpm exec tsgo --emitDeclarationOnly",
    "test:run": "vitest run --maxWorkers=1",
    "typecheck": "pnpm exec tsgo --noEmit"
  },
  "keywords": [
    "database",
    "sqlite",
    "postgresql"
  ],
  "author": "yuuinih",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
