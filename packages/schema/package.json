{
  "name": "@arcadia-eternity/schema",
  "version": "4.3.4",
  "description": "",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcadia-eternity/arcadia-eternity.git",
    "directory": "packages/schema"
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "generate": "tsx script/schema.ts",
    "build": "run-s clear build:code build:types",
    "clear": "rm -rf dist",
    "build:code": "rolldown -c",
    "watch:code": "rolldown -c --watch",
    "watch:types": "pnpm exec tsgo --emitDeclarationOnly --skipLibCheck --watch --preserveWatchOutput",
    "watch": "run-p watch:code watch:types",
    "build:types": "pnpm exec tsgo -p tsconfig.build.json --skipLibCheck",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "pnpm exec tsgo --noEmit --skipLibCheck"
  },
  "keywords": [],
  "author": "yuuinih",
  "license": "MIT",
  "dependencies": {
    "@arcadia-eternity/const": "workspace:*",
    "@sinclair/typebox": "catalog:",
    "nanoid": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE"
  ]
}
