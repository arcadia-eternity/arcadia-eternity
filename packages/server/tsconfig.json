{
  "compilerOptions": {
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "*": ["./*"]
    },
    "composite": true,
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "outDir": "./dist/",
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true
  },
  "include": ["./index.ts", "./src/index.ts", "./src/standalone/**/*.ts"],
  "exclude": ["./node_modules", "./dist"]
}
