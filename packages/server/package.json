{
  "name": "@arcadia-eternity/server",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcadia-eternity/arcadia-eternity.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "run-p build:code build:types",
    "clear": "rm -rf dist",
    "build:code": "rolldown -c",
    "watch:code": "rolldown -c --watch",
    "watch:types": "pnpm exec tsgo --emitDeclarationOnly --watch --preserveWatchOutput",
    "watch": "run-p watch:code watch:types",
    "build:types": "pnpm exec tsgo --emitDeclarationOnly",
    "start": "tsx ../../bin/cli.ts server",
    "dev": "npm run build && npm start",
    "test": "vitest",
    "test:run": "vitest run --maxWorkers=1"
  },
  "keywords": [],
  "author": "yuuinih",
  "license": "MIT",
  "dependencies": {
    "@arcadia-eternity/battle": "workspace:^",
    "@arcadia-eternity/data-pack-base": "workspace:^",
    "@arcadia-eternity/const": "workspace:^",
    "@arcadia-eternity/interface": "workspace:^",
    "@arcadia-eternity/pack-loader": "workspace:^",
    "@arcadia-eternity/protocol": "workspace:^",
    "@arcadia-eternity/schema": "workspace:^",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "nanoid": "catalog:",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "socket.io-client": "catalog:",
    "@types/cors": "^2.8.19",
