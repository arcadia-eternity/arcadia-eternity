{
  "license": "MIT",
  "name": "arcadia-eternity",
  "private": true,
  "version": "4.0.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcadia-eternity/arcadia-eternity.git"
  },
  "scripts": {
    "prepare": "husky",
    "build": "run-s lint build:package typecheck build:cli",
    "build:prod": "pnpm --filter @arcadia-eternity/server... --filter @arcadia-eternity/cli... --filter @arcadia-eternity/client... --filter @arcadia-eternity/p2p-transport... --if-present build && pnpm build:cli && pnpm build:web-distribution",
    "watch": "run-p watch:package watch:cli",
    "clear": "run-p clear:package clear:cli",
    "build:package": "pnpm --filter \"./packages/**\" --filter \"./packs/**\" --filter=!@arcadia-eternity/web-ui --if-present run build",
    "watch:package": "pnpm --filter \"./packages/**\" --filter \"./packs/**\" --filter=!@arcadia-eternity/web-ui --parallel --if-present run watch",
    "clear:package": "pnpm --filter \"./packages/**\" --filter \"./packs/**\" --filter=!@arcadia-eternity/web-ui --if-present run clear",
    "build:cli": "rolldown -c",
    "watch:cli": "rolldown -c --watch",
    "clear:cli": "rm -rf dist",
    "generate": "pnpm --filter @arcadia-eternity/schema run generate",
    "cli": "tsx ./bin/cli.ts",
    "web:dev": "pnpm --filter @arcadia-eternity/web-ui run dev",
    "lint": "run-s lint:workspace lint:battle lint:server lint:web",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "typecheck": "run-s typecheck:packages typecheck:workspace",
    "test": "run-s test:prepare test:types test:run",
    "test:types": "pnpm typecheck",
    "test:run": "pnpm --filter \"./packages/**\" --if-present run test:run",
    "test:watch": "pnpm --filter \"./packages/**\" --if-present run test",
    "test:battle": "pnpm --filter @arcadia-eternity/battle test:run",
    "test:effect-authoring-design": "pnpm --filter @arcadia-eternity/battle exec vitest run --config design/effect-authoring/vitest.config.mjs",
    "typecheck:effect-authoring-design": "pnpm exec tsgo -p packages/battle/design/effect-authoring/tsconfig.json",
    "typecheck:battle": "pnpm exec tsgo -p packages/battle/tsconfig.test.json",
    "test:cli-native": "pnpm exec vitest run bin/__tests__/native-local-battle.test.ts bin/__tests__/native-pack.test.ts --maxWorkers=1",
    "test:web-native": "pnpm --filter @arcadia-eternity/web-ui exec vitest run src/services/__tests__/nativeBattleFactory.test.ts src/p2p/__tests__/p2pBattleSystem.test.ts src/components/battle/__tests__/Tooltip.test.ts --maxWorkers=1",
    "test:web-native:e2e": "pnpm --filter @arcadia-eternity/web-ui exec playwright test e2e/native-local-battle.spec.ts e2e/local-battle.spec.ts e2e/account-g3.spec.ts",
    "verify:battle-native": "node scripts/verify-native-content.mjs",
    "verify:battle-native-pack": "node scripts/verify-native-pack.mjs --browser",
    "verify:battle-waiting-snapshots": "node scripts/verify-waiting-snapshots.mjs --browser",
    "verify:battle-behaviors": "node scripts/verify-behavior-uses.mjs --browser",
    "verify:battle-templates": "node scripts/verify-behavior-uses.mjs --templates --browser",
    "verify:battle-hosts": "node scripts/verify-battle-hosts.mjs --browser",
    "lint:battle": "pnpm exec eslint --config eslint.config.battle.js packages/battle packs/base",
    "battle:demo": "tsx scripts/run-battle.ts",
    "content:inventory": "node scripts/content-structure.mjs inventory --pack packs/base/pack.json --groups packs/base/content-groups.yaml",
    "test:content-structure": "node --test scripts/content-structure.test.mjs",
    "test:cli": "pnpm build:cli && pnpm exec vitest run packages/cli/test --maxWorkers=1",
    "typecheck:cli": "pnpm exec tsgo -p packages/cli/tsconfig.json",
    "test:server": "pnpm --filter @arcadia-eternity/server test:run",
    "typecheck:server": "pnpm exec tsgo -p packages/server/tsconfig.test.json",
    "lint:server": "pnpm exec eslint --config eslint.config.server.js packages/server",
    "build:server": "pnpm --filter @arcadia-eternity/server... --if-present build",
    "test:content-dev": "pnpm --filter @arcadia-eternity/content-dev test:run",
    "build:web-distribution": "pnpm --filter @arcadia-eternity/web-ui build-only && node scripts/stage-paired-website.mjs",
    "pack:ugc": "node scripts/release-author-sdk.mjs pack",
    "verify:ugc-release": "node scripts/release-author-sdk.mjs verify",
    "lint:workspace": "pnpm exec eslint .",
    "typecheck:web": "pnpm --filter @arcadia-eternity/web-ui type-check",
    "lint:web": "pnpm --filter @arcadia-eternity/web-ui exec eslint .",
    "typecheck:workspace": "pnpm exec tsgo --noEmit",
    "typecheck:packages": "pnpm --filter \"./packages/**\" --filter \"./packs/**\" run typecheck",
    "test:prepare": "run-s build:package build:cli"
  },
  "dependencies": {
    "@arcadia-eternity/database": "workspace:^",
    "@arcadia-eternity/content-dev": "workspace:^",
    "@arcadia-eternity/battle": "workspace:^",
    "@arcadia-eternity/client": "workspace:^",
    "@arcadia-eternity/console": "workspace:^",
    "@arcadia-eternity/const": "workspace:^",
    "@arcadia-eternity/data-pack-base": "workspace:^",
    "@arcadia-eternity/interface": "workspace:^",
    "@arcadia-eternity/p2p-transport": "workspace:^",
    "@arcadia-eternity/pack-loader": "workspace:^",
    "@arcadia-eternity/protocol": "workspace:^",
    "@arcadia-eternity/schema": "workspace:^",
    "@arcadia-eternity/server": "workspace:^",
    "@tsparticles/vue3": "^3.0.1",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "i18next": "catalog:",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rolldown": "^1.0.0-rc.18",
    "socket.io": "^4.8.3",
    "ts-morph": "^28.0.0",
    "tsparticles": "^3.9.1",
    "vue-eslint-parser": "^10.4.0",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^1.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript/native-preview": "catalog:",
    "bun-types": "^1.3.13",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.8.3",
    "quicktype": "^26.0.0",
    "quicktype-core": "^26.0.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.59.2",
    "typescript-json-schema": "^0.67.1",
    "undici-types": "^8.2.0",
    "vitest": "catalog:"
  },
  "bin": "./dist/cli.js",
  "workspaces": [
    "packages/*",
    "packs/*"
  ]
}
