{
  "name": "arcadia-eternity",
  "private": true,
  "version": "3.4.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcadia-eternity/arcadia-eternity.git"
  },
  "scripts": {
    "prepare": "husky",
    "build": "run-s lint build:package typecheck build:cli",
    "build:prod": "pnpm --filter @arcadia-eternity/server... --filter @arcadia-eternity/cli... --filter @arcadia-eternity/client... --filter @arcadia-eternity/p2p-transport... --if-present build && pnpm build:cli",
    "watch": "run-p watch:package watch:cli",
    "clear": "run-p clear:package clear:cli",
    "build:package": "pnpm --filter \"./packages/**\" --filter \"./packs/**\" --filter=!@arcadia-eternity/web-ui --if-present run build",
    "watch:package": "pnpm --filter \"./packages/**\" --filter \"./packs/**\" --filter=!@arcadia-eternity/web-ui --parallel --if-present run watch",
    "clear:package": "pnpm --filter \"./packages/**\" --filter \"./packs/**\" --filter=!@arcadia-eternity/web-ui --if-present run clear",
    "build:cli": "rolldown -c",
    "watch:cli": "rolldown -c --watch",
    "clear:cli": "rm -rf dist",
    "generate": "pnpm --filter @arcadia-eternity/schema run generate",
    "cli": "tsx ./bin/cli.ts",
    "web:dev": "pnpm --filter @arcadia-eternity/web-ui run dev",
    "lint": "pnpm exec eslint .",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "typecheck": "pnpm exec tsgo --noEmit",
    "test": "run-s test:types test:run",
    "test:types": "pnpm exec tsgo --noEmit",
    "test:run": "pnpm --filter \"./packages/**\" --if-present run test:run",
    "test:watch": "pnpm --filter \"./packages/**\" --if-present run test",
    "test:battle-baseline": "pnpm --filter @arcadia-eternity/battle run test:run --maxWorkers=2",
    "typecheck:battle-baseline": "pnpm exec tsgo -p packages/battle/tsconfig.baseline.json",
    "lint:battle-baseline": "pnpm exec eslint --config eslint.config.baseline.js packages/battle/src/v2/__tests__/helpers/golden-battle.ts packages/battle/src/v2/__tests__/v2-golden-battle.test.ts packages/battle/src/v2/__tests__/v2-baseline-known-defects.test.ts",
    "test:battle-v4": "pnpm --filter @arcadia-eternity/battle exec vitest run --config vitest.v4.config.mjs",
    "test:effect-authoring-design": "pnpm --filter @arcadia-eternity/battle exec vitest run --config design/effect-authoring/vitest.config.mjs",
    "typecheck:effect-authoring-design": "pnpm exec tsgo -p packages/battle/design/effect-authoring/tsconfig.json",
    "typecheck:battle-v4": "pnpm exec tsgo -p packages/battle/tsconfig.v4-test.json",
    "typecheck:server-native": "pnpm typecheck:server-standalone",
    "test:server-native": "pnpm test:server-standalone",
    "test:cli-native": "pnpm exec vitest run bin/__tests__/native-local-battle.test.ts bin/__tests__/native-pack.test.ts --maxWorkers=1",
    "lint:server-native": "pnpm lint:server-standalone",
    "typecheck:web-native": "pnpm --filter @arcadia-eternity/web-ui exec vue-tsc --noEmit -p tsconfig.native-test.json",
    "test:web-native": "pnpm --filter @arcadia-eternity/web-ui exec vitest run src/services/__tests__/nativeBattleFactory.test.ts src/p2p/__tests__/p2pBattleSystem.test.ts --maxWorkers=1",
    "test:web-native:e2e": "pnpm --filter @arcadia-eternity/web-ui exec playwright test e2e/native-local-battle.spec.ts e2e/local-battle.spec.ts e2e/account-g3.spec.ts",
    "lint:web-native": "pnpm exec eslint --config packages/web-ui/eslint.config.ts packages/web-ui/src/main.ts packages/web-ui/src/services/nativeBattleFactory.ts packages/web-ui/src/services/__tests__/nativeBattleFactory.test.ts packages/web-ui/src/services/serverSession.ts packages/web-ui/src/services/__tests__/serverSession.test.ts packages/web-ui/src/stores/auth.ts packages/web-ui/src/pages/accountPage.vue packages/web-ui/src/components/auth/AuthStatus.vue packages/web-ui/src/pages/localBattlePage.vue packages/web-ui/src/p2p/p2pBattleSystem.ts packages/web-ui/src/stores/privateRoom.ts packages/web-ui/e2e/account-g3.spec.ts",
    "verify:battle-v4-source": "node scripts/verify-v1-port.mjs",
    "verify:battle-v4-native": "node scripts/verify-native-content.mjs",
    "verify:battle-v4-native-pack": "node scripts/verify-native-pack.mjs --browser",
    "verify:battle-v4-waiting-snapshots": "node scripts/verify-waiting-snapshots.mjs --browser",
    "verify:battle-v4-behaviors": "node scripts/verify-behavior-uses.mjs --browser",
    "verify:battle-v4-templates": "node scripts/verify-behavior-uses.mjs --templates --browser",
    "verify:battle-v4-capabilities": "node scripts/verify-behavior-uses.mjs --controlled --browser",
    "verify:battle-v4-hosts": "node scripts/verify-v1-hosts.mjs --browser",
    "lint:battle-v4": "pnpm exec eslint --config eslint.config.v4.js packages/battle/test/v4/*.ts packages/battle/v4.ts packages/battle/v4-host.ts packages/battle/src/v4-host/*.ts packages/battle/v4-legacy.ts packages/battle/src/v4/api.ts packages/battle/src/v4/reactiveValue.ts packages/battle/src/v4/rng.ts packages/battle/src/v4/timer/*.ts packages/battle/src/v4/phase/selection.ts packages/battle/src/v4/phase/battleSwitch.ts packages/battle/src/v4/snapshot.ts packages/battle/src/v4/snapshotBindings.ts packages/battle/src/v4/values/*.ts packages/battle/src/v4/content/*.ts packages/battle/src/v4/content/authoring/*.ts packages/battle/src/v4/execution/*.ts packs/base/src/**/*.ts packs/base/native.ts packages/battle/v4-authoring.ts",
    "battle:v4-demo": "tsx scripts/run-v1-battle.ts",
    "content:inventory": "node scripts/content-structure.mjs inventory --pack packs/base/pack.json --groups packs/base/content-groups.yaml",
    "test:content-structure": "node --test scripts/content-structure.test.mjs",
    "test:cli": "pnpm build:cli && pnpm exec vitest run packages/cli/test --maxWorkers=1",
    "typecheck:cli": "pnpm exec tsgo -p packages/cli/tsconfig.json",
    "test:server-standalone": "pnpm --filter @arcadia-eternity/server test:run",
    "typecheck:server-standalone": "pnpm exec tsgo -p packages/server/tsconfig.standalone-test.json",
    "lint:server-standalone": "pnpm exec eslint --config eslint.config.server-standalone.js 'packages/server/src/standalone/**/*.ts' packages/server/test/standalone*.ts packages/server/test/sessionIdentity.test.ts packages/server/test/account*.test.ts packages/server/test/provider*.test.ts",
    "build:server": "pnpm --filter @arcadia-eternity/server... --if-present build"
  },
  "dependencies": {
    "@arcadia-eternity/battle": "workspace:^",
    "@arcadia-eternity/cli-validator": "workspace:^",
    "@arcadia-eternity/client": "workspace:^",
    "@arcadia-eternity/console": "workspace:^",
    "@arcadia-eternity/const": "workspace:^",
    "@arcadia-eternity/data-pack-base": "workspace:^",
    "@arcadia-eternity/data-repository": "workspace:^",
    "@arcadia-eternity/interface": "workspace:^",
    "@arcadia-eternity/p2p-transport": "workspace:^",
    "@arcadia-eternity/pack-loader": "workspace:^",
    "@arcadia-eternity/protocol": "workspace:^",
    "@arcadia-eternity/schema": "workspace:^",
    "@arcadia-eternity/server": "workspace:^",
    "@tsparticles/vue3": "^3.0.1",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "i18next": "catalog:",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "ts-morph": "^28.0.0",
    "tsparticles": "^3.9.1",
    "vue-eslint-parser": "^10.4.0",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^1.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript/native-preview": "catalog:",
    "bun-types": "^1.3.13",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.8.3",
    "quicktype": "^26.0.0",
    "quicktype-core": "^26.0.0",
    "rolldown": "^1.0.0-rc.18",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.59.2",
    "typescript-json-schema": "^0.67.1",
    "undici-types": "^8.2.0",
    "vitest": "catalog:"
  },
  "bin": "./dist/cli.js",
  "workspaces": [
    "packages/*",
    "packs/*"
  ]
}
