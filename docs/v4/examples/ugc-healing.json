{
  "formatVersion": 1,
  "id": "ugc_heal_when_hurt",
  "parameters": {
    "threshold": { "nodeId": "hp-threshold", "kind": "number", "value": 0.5 },
    "healing": { "nodeId": "healing-ratio", "kind": "number", "value": 0.25 }
  },
  "trigger": { "nodeId": "hit", "id": "core.selfSkillHit" },
  "when": { "nodeId": "hurt", "id": "core.ownerHpBelowRatio", "params": { "ratio": { "parameter": "threshold" } } },
  "actions": [{ "stepId": "heal", "id": "core.healOwnerByMaxHp", "params": { "ratio": { "parameter": "healing" } } }]
}
